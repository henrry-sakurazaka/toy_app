<div id="<%= dom_id user %>">
  <p>
    <strong>Name:</strong>
    <%= user.name %>
  </p>

  <p>
    <strong>Email:</strong>
    <%= user.email %>
  </p>
  <% user.microposts.each do |micropost| %>
    <p>
      <strong>Comment:</strong>
    </p>
      <%= micropost.content %>
    <p>
    </p>
  <% end %>

</div>
